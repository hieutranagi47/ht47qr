# SERVER_PORT is the local listener and the Compose host port.
# PORT is used only by Dockerfile.vercel; Dockerfile uses SERVER_PORT.
PORT=80
SERVER_PORT=8888
SERVER_PORT_TLS=8443
SERVER_SSE_PORT=8886
SERVER_SSE_PORT_TLS=8446
# gRPC uses TLS_CERT/TLS_KEY. Leave empty to disable the listener.
SERVER_GRPC_PORT=8447
# Use postgres in deployments to require a database URL; sqlite forces local storage.
DATABASE_BACKEND="auto"
# SQLite remains the default when both PostgreSQL URLs are empty.
SQLITE_PATH="./data/htqrcode.db"
# PostgreSQL: DATABASE_URL takes precedence over POSTGRES_URL.
# Supply connection URLs at runtime, never in Dockerfiles.
# Compose sets DATABASE_BACKEND and DATABASE_URL to its PostgreSQL service.
DATABASE_URL=""
POSTGRES_URL=""
# Optional direct connection for migrations (defaults to the application pool).
DATABASE_URL_UNPOOLED=""
POSTGRES_URL_NON_POOLING=""
# Docker Compose PostgreSQL settings. Use URL-safe values; change the password
# before deploying. These initialize a NEW postgres-data volume only.
POSTGRES_USER=htqrcode
POSTGRES_PASSWORD=htqrcode-local
POSTGRES_DB=htqrcode
# Local Docker TURN relay. Keep 127.0.0.1 for two browsers on this computer.
# For LAN testing, use this computer's LAN IPv4 address and HTTPS for the game.
CARO_TURN_HOST=127.0.0.1
CARO_TURN_SECRET=caro-local-development-only
CARO_ICE_TRANSPORT_POLICY=relay
# Outside Compose, configure TURN URLs explicitly (comma separated).
CARO_TURN_URLS=""
# ExpressTURN FREE tier: only username/password are needed; no secret key.
# Set both credentials below in your local .env or deployment runtime settings.
# Outside Compose, empty URLs default to free.expressturn.com:3478 when credentials
# are set. In Compose, set the URLs explicitly to override the local coturn relay.
# Use the exact host/port from your ExpressTURN dashboard if it differs:
# CARO_TURN_URLS=turn:free.expressturn.com:3478?transport=udp,turn:free.expressturn.com:3478?transport=tcp
# CARO_TURN_USERNAME=sample-turn-username
# CARO_TURN_PASSWORD=sample-turn-password
# CARO_TURN_SECRET=
# CARO_ICE_TRANSPORT_POLICY=all
CARO_TURN_USERNAME=""
CARO_TURN_PASSWORD=""
GATEWAY_ADDR="http://localhost"

# OpenTelemetry tracing. Leave the endpoint empty to use GATEWAY_ADDR/jaeger-api/v1/traces.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
OTEL_SERVICE_NAME="htqrcode"

TEMP_STORAGE_FOLDER_NAME="galleries"
TEMP_GALLERY_DIR="/app/galleries"

# PEM content, including BEGIN/END lines and real newlines (not file paths).
# The Compose template supplies the local development certificate and key.
TLS_CERT=""
TLS_KEY=""
