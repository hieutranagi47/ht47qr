# Build from the repository root: docker build -f Dockerfile.vercel .
FROM node:24-alpine AS fe_builder

WORKDIR /app/fe

RUN npm install --global pnpm@10.8.1

COPY fe/package.json fe/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY fe/angular.json fe/tsconfig*.json ./
COPY fe/src/ ./src/
COPY fe/public/ ./public/

RUN pnpm run build --configuration production

FROM golang:1.27.1-alpine AS builder

RUN apk --no-cache add ca-certificates pkgconf gcc libc-dev musl-dev git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Replace checked-in assets with the production frontend before Go embeds them.
RUN rm -rf /app/client/api
COPY --from=fe_builder /app/client/api/ /app/client/api/

RUN CGO_ENABLED=1 go build -tags musl -trimpath -o /app/htqrcode ./cmd

FROM golang:1.27.1-alpine AS runtime

RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /app/htqrcode /app/htqrcode

# The service requires all four listeners; Vercel routes to the HTTP listener.
ENV SERVER_PORT_TLS=8443 \
    SERVER_SSE_PORT=8081 \
    SERVER_SSE_PORT_TLS=8444

# Configure POSTGRES_URL, TLS_CERT and TLS_KEY in Vercel's environment settings.
# Vercel routes HTTP to port 80 unless PORT is set in the project settings.
EXPOSE 80

# Map Vercel's port to the service's setting and forward signals to the binary.
CMD ["sh", "-c", "export SERVER_PORT=\"${PORT:-80}\"; exec /app/htqrcode"]
