# --- Stage 1: Build the Go binary ---
FROM golang:1.27.1-alpine AS build

# Set the working directory inside the container
WORKDIR /src

# Copy go.mod and go.sum files to cache dependencies
COPY go.mod go.sum* ./
RUN go mod download

# Copy the rest of the source code
COPY . .

# Build the application with optimizations for minimal/container environments
# CGO_ENABLED=0 creates a statically linked binary (no libc dependencies needed)
RUN CGO_ENABLED=0 GOOS=linux go build -o /server main.go

# --- Stage 2: Final lightweight runtime ---
FROM alpine:3.22

# Copy the binary from the build stage
COPY --from=build /server /server

# Vercel provides a $PORT environment variable.
# Explicitly document that the application listens on it.
EXPOSE 80

# Run the binary
CMD ["/server"]