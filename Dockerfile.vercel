# Build from the repository root: docker build -f Dockerfile.vercel .
FROM node:24-alpine AS fe_builder

WORKDIR /app/fe

RUN npm install --global pnpm@10.8.1

COPY fe/package.json fe/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY fe/angular.json fe/tsconfig*.json ./
COPY fe/src/ ./src/
COPY fe/public/ ./public/

RUN pnpm run build --configuration production

FROM golang:1.27.1-alpine AS builder

RUN apk --no-cache add ca-certificates pkgconf gcc libc-dev musl-dev git protobuf

# Install the tools required by task gen (protobuf and SQL generation).
RUN --mount=type=cache,target=/go/pkg/mod \
    go install github.com/go-task/task/v3/cmd/task@v3.53.1 \
    && go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.12 \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1 \
    && go install github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1

WORKDIR /app

COPY go.mod go.sum ./
# RUN go mod download
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

# Replace checked-in assets with the production frontend before Go embeds them.
RUN rm -rf /app/client/api
COPY --from=fe_builder /app/client/api/ /app/client/api/

RUN --mount=type=cache,target=/go/pkg/mod task gen
RUN CGO_ENABLED=1 go build -tags musl -trimpath -o /app/htqrcode ./cmd

FROM golang:1.27.1-alpine AS runtime

RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /app/htqrcode /app/htqrcode

# The service requires all four listeners; Vercel routes to the HTTP listener.
ENV SERVER_PORT_TLS=8443 \
    SERVER_SSE_PORT=8081 \
    SERVER_SSE_PORT_TLS=8444

ENV GOMAXPROCS=2
ENV GODEBUG=madvdontneed=1,netdns=go,gctrace=1,schedtrace=1000
ENV GOMEMLIMIT=1800MiB
ENV GOGC=90
ENV TZ=Asia/Ho_Chi_Minh
ENV SERVER_PORT="8888"
ENV SERVER_PORT_TLS="8443"
ENV SERVER_SSE_PORT="8886"
ENV SERVER_SSE_PORT_TLS="8446"
ENV DATABASE_BACKEND=postgres

# Supply DATABASE_URL (or POSTGRES_URL) through Vercel runtime environment settings.
# Optionally set DATABASE_URL_UNPOOLED (or POSTGRES_URL_NON_POOLING) for migrations.
